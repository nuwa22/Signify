<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    tools:context=".ui.MainActivity">

    <TextView
        android:id="@+id/appTitleText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="Signify"
        android:textColor="#1565C0"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="@font/noto_sans_sinhala_bold"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_manage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/appTitleText" />

    <FrameLayout
        android:id="@+id/cameraFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="#F0F0F0"
        android:clipToOutline="true"
        android:elevation="6dp"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@id/resultCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="430dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTitleText">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.logicroom.signify.ui.LandmarkOverlayView
            android:id="@+id/landmarkOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/scanningBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#CCFFFFFF"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="7dp"
                android:background="#4CAF50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="හඳුනාගනිමින්"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_sans_sinhala_regular" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="212dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="#F5F5F5"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cameraFrame"
        app:layout_constraintVertical_bias="1">

        <TextView
            android:id="@+id/recognizedLabelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="හඳුනාගත් සංඥාව"
            android:textColor="#333333"
            android:textSize="14sp"
            android:fontFamily="@font/noto_sans_sinhala_regular" />

        <TextView
            android:id="@+id/recognizedSentenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="—"
            android:textColor="#111111"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_sans_sinhala_bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>